# Root EditorConfig
root = true

# ------------------------------------------------------------------------------
# Global defaults
# ------------------------------------------------------------------------------
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ------------------------------------------------------------------------------
# Python (LF, 4 spaces)
# ------------------------------------------------------------------------------
[*.py]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8

# ------------------------------------------------------------------------------
# PowerShell (CRLF, UTF-8 BOM, 4 spaces)
# Windows-native scripts must use CRLF to avoid execution issues
# ------------------------------------------------------------------------------
[*.ps1]
end_of_line = crlf
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.psm1]
end_of_line = crlf
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.psd1]
end_of_line = crlf
charset = utf-8-bom
indent_style = space
indent_size = 4

# ------------------------------------------------------------------------------
# Batch files (CRLF)
# ------------------------------------------------------------------------------
[*.bat]
end_of_line = crlf
indent_style = tab

[*.cmd]
end_of_line = crlf
indent_style = tab

# ------------------------------------------------------------------------------
# Shell scripts (LF)
# ------------------------------------------------------------------------------
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# ------------------------------------------------------------------------------
# JSON, YAML, TOML, SQL (LF)
# ------------------------------------------------------------------------------
[*.json]
end_of_line = lf
indent_style = space
indent_size = 2

[*.yaml]
end_of_line = lf
indent_style = space
indent_size = 2

[*.yml]
end_of_line = lf
indent_style = space
indent_size = 2

[*.toml]
end_of_line = lf
indent_style = space
indent_size = 2

[*.sql]
end_of_line = lf
indent_style = space
indent_size = 4

# ------------------------------------------------------------------------------
# Markdown (LF)
# ------------------------------------------------------------------------------
[*.md]
end_of_line = lf
trim_trailing_whitespace = false

# ------------------------------------------------------------------------------
# Makefiles (tabs required)
# ------------------------------------------------------------------------------
[Makefile]
indent_style = tab

# ------------------------------------------------------------------------------
# PyInstaller spec files (LF)
# ------------------------------------------------------------------------------
[*.spec]
end_of_line = lf
indent_style = space
indent_size = 4
