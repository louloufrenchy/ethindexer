postgres:
  host: 192.168.0.28
  port: 5432
  user: postgres
  password: ${PGPASSWORD}
  database: forensic
  min_pool: 1
  max_pool: 10
  timeout: 60

btc:
  enabled: true
  endpoint_1: "${QUICKNODE_BTC_ENDPOINT_1}"
  endpoint_2: "${QUICKNODE_BTC_ENDPOINT_2}"
  start_block: 0
  batch_size: 200
  parallel_fetchers: 2
  worker_threads: 4
  reorg_depth: 6
  max_retries: 5
  retry_delay: 2

logging:
  level: "INFO"
  file: "logs/indexer_btc.log"
  rotate: true
  max_size_mb: 20
  backups: 5

chains:
  - btc
