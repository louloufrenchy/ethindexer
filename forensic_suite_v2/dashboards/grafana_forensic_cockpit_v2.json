    {
      "id": 1,
      "type": "stat",
      "title": "ETH – Last Block Indexed",
      "datasource": "ForensicPostgres",
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT now() AS time, MAX(block_number) AS value FROM indexer_metrics WHERE chain = 'eth';",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 3, "w": 8, "x": 0, "y": 1 }
    },
    {
