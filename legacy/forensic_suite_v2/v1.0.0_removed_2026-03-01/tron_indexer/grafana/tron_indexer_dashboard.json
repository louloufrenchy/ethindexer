{
  "title": "TRON Indexer Dashboard",
  "panels": [
    {
      "type": "stat",
      "title": "Last Indexed Block",
      "targets": [
        { "expr": "tron_last_indexed_block" }
      ]
    },
    {
      "type": "graph",
      "title": "Indexing Speed (blocks/sec)",
      "targets": [
        { "expr": "rate(tron_blocks_indexed_total[5m])" }
      ]
    },
    {
      "type": "graph",
      "title": "RPC Errors",
      "targets": [
        { "expr": "rate(tron_rpc_errors_total[5m])" }
      ]
    },
    {
      "type": "graph",
      "title": "DB Write Latency (95th percentile)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tron_db_write_seconds_bucket[5m])) by (le))"
        }
      ]
    }
  ]
}
